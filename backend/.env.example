# Copy this file to .env and fill in your values.
# Never commit .env — it's already gitignored.

# PostgreSQL. Option A: single connection string (takes priority if set).
# For Supabase: Project Settings -> Database -> Connection string -> URI,
# "Session pooler", and set DB_SSL=true below.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intervu

# Option B: discrete fields (used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=intervu
PGUSER=postgres
PGPASSWORD=postgres

# Set true only if your Postgres server requires TLS (most hosted ones do)
DB_SSL=false

PORT=3001
CORS_ORIGIN=http://localhost:5174
# The publicly-reachable origin the app is served from — same value as
# CORS_ORIGIN in practice, but used separately to build the Google OAuth
# redirect URI and the post-login redirect target. In dev this is where
# Vite proxies /api to this server.
PUBLIC_URL=http://localhost:5174

# Random string used to sign the app's own auth JWT (httpOnly cookie).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Google sign-in (optional — email/password works without it).
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth
# client ID -> Web application. Add
#   http://localhost:5174/api/auth/google/callback
# as an Authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI Resume Assistant (RAG) ---
# Chat: Groq (https://console.groq.com/keys) — free tier, OpenAI-compatible
# API, used only for generating the grounded answer.
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Embeddings: a local sentence-transformer model running in-process via
# @huggingface/transformers (ONNX/WASM) — free, no API key, no external
# service to install or run. Downloads once on first use and is cached
# locally after that. Changing EMBEDDING_MODEL after ingesting requires
# re-running `npm run ingest` (vector dimensions won't match old ones).
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Which pre-built index to query at runtime: "small" (Strategy A — ~300
# word chunks / 50 word overlap) or "large" (Strategy B — ~700 word
# chunks / 100 word overlap). `npm run ingest` builds both regardless of
# this setting, so switching strategies is just changing this and restarting.
CHUNK_STRATEGY=small

# How many chunks to retrieve per question.
RAG_TOP_K=5

# Minimum cosine similarity (0-1) the top retrieved chunk must clear before
# the LLM is even called. Below this, the API returns the "could not find
# sufficient information" fallback without spending an LLM call.
RAG_SIMILARITY_THRESHOLD=0.35

